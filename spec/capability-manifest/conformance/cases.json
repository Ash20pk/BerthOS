{
  "specVersion": "1.1.0",
  "description": "Conformance corpus for the Capability Manifest Specification. See SPEC.md section 7.",
  "cases": [
    {
      "id": "match-exact",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "github:read:repos",
      "requested": "github:read:repos",
      "expect": {
        "matches": true
      }
    },
    {
      "id": "match-ns-differs",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "github:read:repos",
      "requested": "gitlab:read:repos",
      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-action-differs",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "github:read:repos",
      "requested": "github:write:repos",
      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-action-no-glob",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "github:*:repos",
      "requested": "github:read:repos",
      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-ns-no-glob",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "*:read:repos",
      "requested": "github:read:repos",
      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-scope-glob-prefix",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "browser:navigate:*.github.com",
      "requested": "browser:navigate:api.github.com",
      "expect": {
        "matches": true
      }
    },
    {
      "id": "match-scope-glob-no-bare",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "browser:navigate:*.github.com",
      "requested": "browser:navigate:github.com",
      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-scope-star-all",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "browser:navigate:*",
      "requested": "browser:navigate:anything/at.all",
      "expect": {
        "matches": true
      }
    },
    {
      "id": "match-scope-glob-crosses-slash",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "filesystem:read:/workspace/*",
      "requested": "filesystem:read:/workspace/a/b/c",
      "expect": {
        "matches": true
      }
    },
    {
      "id": "match-scope-literal-question",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "browser:navigate:a?c.com",
      "requested": "browser:navigate:abc.com",
      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-scope-literal-bracket",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "browser:navigate:a[b].com",
      "requested": "browser:navigate:a[b].com",
      "expect": {
        "matches": true
      }
    },
    {
      "id": "match-scope-dot-is-literal",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "browser:navigate:a.com",
      "requested": "browser:navigate:axcom",
      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-not-symmetric",
      "tags": [
        "core"
      ],
      "op": "match",
