      "expect": {
        "matches": false
      }
    },
    {
      "id": "match-scope-with-colon",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "network:connect:127.0.0.1:8080",
      "requested": "network:connect:127.0.0.1:8080",
      "expect": {
        "matches": true
      }
    },
    {
      "id": "match-scope-glob-over-colon",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "network:connect:127.0.0.1:*",
      "requested": "network:connect:127.0.0.1:8080",
      "expect": {
        "matches": true
      }
    },
    {
