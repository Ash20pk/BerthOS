      "id": "match-multi-star",
      "tags": [
        "core"
      ],
      "op": "match",
      "granted": "browser:navigate:*.github.*",
      "requested": "browser:navigate:api.github.io",
      "expect": {
        "matches": true
      }
    },
    {
      "id": "valid-minimal",
      "tags": [
        "core"
      ],
      "op": "validate",
      "manifest": {
        "name": "app",
        "version": "1.0.0"
      },
      "expect": {
        "valid": true,
        "normalized": {
          "name": "app",
          "version": "1.0.0",
          "description": "",
          "capabilities": [],
          "exports": [],
          "expose": {
            "browser": true,
            "terminal": true,
            "preview": false
          },
          "governs": false,
          "governance": {
            "exempt": false
          },
          "resources": {}
        }
      },
      "note": "defaults are applied on normalization"
    },
    {
      "id": "valid-capabilities",
      "tags": [
        "core"
      ],
      "op": "validate",
      "manifest": {
        "name": "app",
        "version": "1.0.0",
        "capabilities": [
          "github:read:repos",
          "filesystem:read:/workspace",
          "filesystem:write:/workspace/out",
          "filesystem:write:/tmp/scratch",
          "filesystem:read:/context",
          "filesystem:write:/app",
          "network:connect:443",
          "network:connect:*",
          "network:peer:db",
          "app:invoke:indexer",
          "browser:navigate:*.github.com",
          "terminal:attach:*"
        ]
      },
      "expect": {
        "valid": true
      }
    },
    {
      "id": "valid-fs-trailing-glob",
      "tags": [
        "core"
      ],
      "op": "validate",
      "manifest": {
        "name": "app",
        "version": "1.0.0",
        "capabilities": [
          "filesystem:write:/workspace/*"
        ]
      },
      "expect": {
        "valid": true
      }
    },
    {
      "id": "valid-duplicate-capabilities",
      "tags": [
        "core"
      ],
      "op": "validate",
      "manifest": {
        "name": "app",
        "version": "1.0.0",
        "capabilities": [
          "github:read:repos",
          "github:read:repos"
        ]
      },
      "expect": {
        "valid": true
      },
      "note": "duplicates are one declaration, never an error (4.3)"
    },
    {
      "id": "valid-unknown-namespace",
      "tags": [
        "core"
      ],
      "op": "validate",
      "manifest": {
        "name": "app",
        "version": "1.0.0",
        "capabilities": [
          "quantum:entangle:everything"
        ]
      },
      "expect": {
        "valid": true
      },
      "note": "unregistered namespaces validate; they must not be reported as enforced (4.3)"
    },
    {
      "id": "valid-unregistered-action",
      "tags": [
        "core"
      ],
      "op": "validate",
      "manifest": {
        "name": "app",
        "version": "1.0.0",
        "capabilities": [
