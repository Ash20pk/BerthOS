{
  "name": "berth",
  "private": true,
  "version": "0.1.0",
  "description": "Berth — the runtime and framework for AI agent workers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "publish:npm:dry-run": "turbo run build && pnpm -r publish --no-git-checks --dry-run",
    "publish:npm": "turbo run build && pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "npm:onnxruntime-web@1.14.0",
      "sharp": "link:packages/sdk/vendor/sharp-stub",
      "protobufjs": "^8.7.1",
      "uuid": "^11.1.1"
    }
  }
}
