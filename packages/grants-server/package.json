{
  "name": "@berth/grants-server",
  "version": "0.1.0",
  "description": "Local human-approval service for Phase 3 capability grants: request/approve/deny, consulted by generate-capability-policy.ts on the app's next boot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "berth-grants": "./dist/server.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2"
  }
}
