{
  "name": "@berth/adapter-k8s",
  "version": "0.1.0",
  "description": "DeployAdapter implementation targeting a Kubernetes cluster",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@berth/adapter-core": "workspace:*",
    "@berth/manifest-schema": "workspace:*"
  },
  "peerDependencies": {
    "@kubernetes/client-node": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@kubernetes/client-node": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "@berth/docker-orchestrator": "workspace:*",
    "dockerode": "^4.0.3"
  }
}
