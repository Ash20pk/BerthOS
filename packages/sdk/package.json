{
  "name": "@berth/sdk",
  "version": "0.1.0",
  "description": "Resident app SDK: defineApp(), lifecycle hooks, context bus client — runs inside the sandbox",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "berth-runtime": "./dist/runtime.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "proto",
    "models"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "ai-agents",
    "resident-app",
    "sdk",
    "sandbox"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-external.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/*.test.js dist/*/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/prefetch-embedding-model.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@berth/manifest-schema": "workspace:*",
    "@xenova/transformers": "2.17.2",
    "protobufjs": "^8.7.2",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
