{
  "name": "@berth/seam-openai-agents",
  "version": "0.1.0",
  "description": "Berth tools as OpenAI Agents SDK function tools — kernel-enforced capabilities inside a loop you already run",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/seam-openai-agents"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "openai",
    "openai-agents",
    "ai-agents",
    "sandbox",
    "capabilities"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --experimental-test-module-mocks --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0",
    "@openai/agents": "^0.17.0"
  },
  "peerDependencies": {
    "@openai/agents": "^0.17.0"
  },
  "peerDependenciesMeta": {
    "@openai/agents": {
      "optional": true
    }
  }
}
