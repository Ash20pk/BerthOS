    { "appName": "net-open", "capabilities": ["network:connect:*", "network:connect:22"] },
    { "appName": "binder", "capabilities": ["network:bind:8080", "network:bind:*", "network:bind:0", "network:bind:65535"] },
    { "appName": "mesh", "capabilities": ["network:peer:crew-*", "network:peer:crew-*", "network:connect:443"] },
    { "appName": "term", "capabilities": ["terminal:attach:*", "filesystem:read:/workspace"] },
