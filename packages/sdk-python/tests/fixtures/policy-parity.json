    { "appName": "reader", "capabilities": ["filesystem:read:/workspace/data", "filesystem:read:/app/*"] },
    { "appName": "github-reader", "capabilities": ["github:read:repos", "filesystem:read:/workspace"] },
    { "appName": "github-no-reads", "capabilities": ["github:write:issues"] },
