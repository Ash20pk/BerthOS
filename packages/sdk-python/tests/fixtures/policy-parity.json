{
  "description": "Capability lists compiled by both generate-capability-policy.ts and berth_sdk.generate_capability_policy; tests/test_policy_parity.py asserts identical output. The conformance corpus's manifests are added to these at test time.",
  "cases": [
    { "appName": "empty", "capabilities": [] },
