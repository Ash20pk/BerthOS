{
  "name": "@berth/registry-server",
  "version": "0.1.0",
  "description": "Local app registry: publish/discover/install resident apps (Phase 5)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "berth-registry": "./dist/server.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@berth/manifest-schema": "workspace:*",
    "@fastify/multipart": "^10.1.0",
    "fastify": "^5.2.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2"
  }
}
