{
  "name": "@berth/registry-server",
  "version": "0.1.0",
  "description": "Local app registry: publish/discover/install resident apps (Phase 5)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "berth-registry": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/mock-server.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/registry-server"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "app-registry",
    "ai-agents",
    "plugin-registry"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@berth/tls": "workspace:*",
    "@berth/manifest-schema": "workspace:*",
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.12.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0"
  }
}
