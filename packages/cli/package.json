{
  "name": "@berth/cli",
  "version": "0.1.0",
  "description": "The berth CLI — init, dev, test, publish, deploy",
  "type": "module",
  "bin": {
    "berth": "./bin/berth.js"
  },
  "files": [
    "dist",
    "bin",
    "src/templates"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "cli",
    "ai-agents",
    "agent-framework",
    "sandbox"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "bin": "berth",
    "dirname": "berth",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@berth/adapter-core": "workspace:*",
    "@berth/adapter-daytona": "workspace:*",
    "@berth/adapter-e2b": "workspace:*",
    "@berth/adapter-k8s": "workspace:*",
    "@berth/agents": "workspace:*",
    "@berth/docker-orchestrator": "workspace:*",
    "@berth/manifest-schema": "workspace:*",
    "@berth/sdk": "workspace:*",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oclif/core": "^4.13.3",
    "dockerode": "^5.0.1",
    "tar-fs": "^3.0.6",
    "yaml": "^2.7.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@berth/registry-server": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.1.2",
    "@types/tar-fs": "^2.0.4",
    "oclif": "^4.23.30",
    "typescript": "^7.0.2"
  }
}
