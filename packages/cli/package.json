{
  "name": "@berth/cli",
  "version": "0.1.0",
  "description": "The berth CLI — init, dev, test, publish, deploy",
  "type": "module",
  "bin": {
    "berth": "./bin/berth.js"
  },
  "files": [
    "dist",
    "bin",
    "src/templates"
  ],
  "oclif": {
    "bin": "berth",
    "dirname": "berth",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@berth/adapter-core": "workspace:*",
    "@berth/adapter-daytona": "workspace:*",
    "@berth/adapter-e2b": "workspace:*",
    "@berth/docker-orchestrator": "workspace:*",
    "@berth/manifest-schema": "workspace:*",
    "@berth/sdk": "workspace:*",
    "@inquirer/prompts": "^7.2.1",
    "@oclif/core": "^4.2.0",
    "dockerode": "^4.0.3",
    "tar-fs": "^3.0.6",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@berth/registry-server": "workspace:*",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.10.5",
    "@types/tar-fs": "^2.0.4",
    "oclif": "^4.17.0",
    "typescript": "^5.7.3"
  }
}
