{
  "name": "@berthos/cli",
  "version": "0.2.0",
  "description": "The berth CLI — init, dev, test, doctor, mcp, attest, os, snapshot, publish, deploy",
  "type": "module",
  "bin": {
    "berth": "./bin/berth.js"
  },
  "files": [
    "dist",
    "bin",
    "src/templates",
    "!dist/**/*.test.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "cli",
    "ai-agents",
    "agent-framework",
    "sandbox"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "oclif": {
    "bin": "berth",
    "dirname": "berth",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@berthos/audit": "workspace:*",
    "@berthos/docker-orchestrator": "workspace:*",
    "@berthos/manifest-schema": "workspace:*",
    "@berthos/sdk": "workspace:*",
    "@berthos/tls": "workspace:*",
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@oclif/core": "^5.0.1",
    "dockerode": "^5.0.1",
    "tar-fs": "^3.0.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@berthos/adapter-core": "workspace:*",
    "@berthos/adapter-daytona": "workspace:*",
    "@berthos/adapter-e2b": "workspace:*",
    "@berthos/adapter-k8s": "workspace:*",
    "@berthos/agents": "workspace:*",
    "@berthos/registry-server": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.2",
    "@types/tar-fs": "^2.0.4",
    "oclif": "^6.0.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@berthos/adapter-daytona": "workspace:^",
    "@berthos/adapter-e2b": "workspace:^",
    "@berthos/adapter-k8s": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@berthos/adapter-daytona": {
      "optional": true
    },
    "@berthos/adapter-e2b": {
      "optional": true
    },
    "@berthos/adapter-k8s": {
      "optional": true
    }
  }
}
