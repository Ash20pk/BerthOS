# Berth guest kernel: config delta applied on top of libkrunfw v5.6.2's
# config-libkrunfw_aarch64 (linux 6.12.109). See docs/design/microvm-spike.md.

# LSM framework + Landlock (ABI 6 on 6.12). Landlock is only active when it is
# in the LSM list, so bake the list in rather than relying on lsm= on the cmdline.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,yama"

# Already on in libkrunfw; listed so the check script asserts them.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y

# Optional: kernel WireGuard (mesh uses boringtun over TUN today).
CONFIG_WIREGUARD=y

# Hardening. No TSI means init.krun has no use for dummy0, so drop the driver
# and the guest has lo only. io_uring can create sockets without going through
# the seccomp-filtered socket(2) path; turn it off at the kernel (the option is
# only visible with EXPERT, which exposes options and changes no values here).
CONFIG_EXPERT=y
# CONFIG_DUMMY is not set
# CONFIG_IO_URING is not set
# CONFIG_USERFAULTFD is not set
