{
  "name": "@berth/audit",
  "version": "0.1.0",
  "description": "Structured audit records with a verifiable actor, a hash-chained file sink, and payload redaction",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/audit"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "ai-agents",
    "audit",
    "observability",
    "compliance"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0"
  }
}
