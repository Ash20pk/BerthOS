{
  "name": "@berth/agents",
  "version": "0.1.0",
  "description": "computer -> agent -> tool: boots a Berth computer loaded with resident apps, generates a tool list from their exports, and wires any LLM provider into single- or multi-agent crews",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@berth/manifest-schema": "workspace:*",
    "@berth/docker-orchestrator": "workspace:*",
    "@berth/sdk": "workspace:*",
    "@berth/adapter-core": "workspace:*",
    "@anthropic-ai/sdk": "^0.115.0",
    "openai": "^7.2.0",
    "dockerode": "^5.0.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2",
    "@types/dockerode": "^4.0.1"
  }
}
