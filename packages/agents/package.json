{
  "name": "@berth/agents",
  "version": "0.1.0",
  "description": "computer -> agent -> tool: boots a Berth computer loaded with resident apps, generates a tool list from their exports, and wires any LLM provider into single- or multi-agent crews",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "ai-agents",
    "agent-framework",
    "llm",
    "mcp",
    "opentelemetry",
    "sandbox",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@anthropic-ai/sdk": "^0.115.0",
    "@berth/adapter-core": "workspace:*",
    "@berth/docker-orchestrator": "workspace:*",
    "@berth/grants-server": "workspace:*",
    "@berth/manifest-schema": "workspace:*",
    "@berth/sdk": "workspace:*",
    "@google/genai": "^2.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "dockerode": "^5.0.1",
    "openai": "^7.2.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.1.2",
    "ai": "^7.0.52",
    "typescript": "^7.0.2"
  }
}
