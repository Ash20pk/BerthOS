{
  "name": "@berth/docker-orchestrator",
  "version": "0.1.0",
  "description": "Docker-based Agent OS stand-in: Alpine base image, container lifecycle, hot reload",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docker",
    "!dist/**/*.test.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/docker-orchestrator"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "docker",
    "sandbox",
    "container",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@berth/manifest-schema": "workspace:*",
    "dockerode": "^5.0.1",
    "chokidar": "^5.0.0",
    "tar-fs": "^3.0.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0",
    "@types/dockerode": "^4.0.1",
    "@types/tar-fs": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
