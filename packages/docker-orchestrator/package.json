{
  "name": "@berth/docker-orchestrator",
  "version": "0.1.0",
  "description": "Docker-based Agent OS stand-in: Alpine base image, container lifecycle, hot reload",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "docker"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@berth/manifest-schema": "workspace:*",
    "dockerode": "^4.0.3",
    "chokidar": "^4.0.3",
    "tar-fs": "^3.0.6"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "@types/dockerode": "^3.3.31",
    "@types/tar-fs": "^2.0.4"
  }
}
