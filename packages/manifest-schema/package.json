{
  "name": "@berth/manifest-schema",
  "version": "0.1.0",
  "description": "Schema, validation, and capability-string parsing for berth.yml",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/mock-server.*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ash20pk/BerthOS.git",
    "directory": "packages/manifest-schema"
  },
  "homepage": "https://github.com/Ash20pk/BerthOS#readme",
  "bugs": {
    "url": "https://github.com/Ash20pk/BerthOS/issues"
  },
  "author": "Berth Contributors",
  "keywords": [
    "ai-agents",
    "schema",
    "validation",
    "capability-tokens"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2"
  }
}
