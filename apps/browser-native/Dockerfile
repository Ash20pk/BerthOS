# browser-native extends the shared Berth base image — it inherits
# Chromium/Xvfb/x11vnc already installed there, so this file only exists to
# satisfy `docker build` tooling that expects an app-local Dockerfile; the
# actual build is driven by @berth/docker-orchestrator, which stages this
# app's source together with packages/docker-orchestrator/docker/base.Dockerfile.
# See packages/docker-orchestrator/src/image.ts.
